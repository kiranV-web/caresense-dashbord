# Plain HTTP just redirects to HTTPS. Certbot renewal uses the standalone
# plugin with pre/post hooks that stop/start this container (see the deploy
# runbook), not a webroot challenge — so no ACME exception is needed here.
server {
    listen 80;
    server_name ${SERVER_NAME};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    # Docker's embedded DNS. Resolving the upstream through a variable (below)
    # instead of a bare proxy_pass hostname defers resolution to request time
    # — otherwise nginx either refuses to start when the "api" container isn't
    # up yet, or caches its IP forever and breaks silently after the api
    # container gets recreated/redeployed with a new IP.
    resolver 127.0.0.11 valid=10s;

    # Reverse-proxy API calls to the backend container by its Docker Compose
    # service name, so the browser only ever talks to this one origin — the
    # frontend's relative "/api/v1/..." fetch calls (see apiClient.ts /
    # uploadService.ts) work unmodified in production, exactly as the Vite
    # dev proxy makes them work in development.
    location /api/ {
        set $upstream_api ${API_HOST}:${API_PORT};
        # $request_uri (the exact original path + query string) is appended
        # manually because a variable upstream disables nginx's normal
        # location-prefix rewriting — proxy_pass here would otherwise forward
        # every request as a bare "/api/" regardless of the real path.
        proxy_pass http://$upstream_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 1024m;
    }

    # Static assets — long cache, filenames are content-hashed by Vite.
    location ~* \.(?:css|js|svg|woff2?|ttf|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # React Router client-side routing — any unmatched path falls back to
    # index.html rather than 404ing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
